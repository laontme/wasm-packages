+++ b/internal/oci/symlink_mode_test.go
@@ -0,0 +1,26 @@
+package oci
+
+import (
+	"archive/tar"
+	"testing"
+)
+
+func TestNormalizeSymlinkMode(t *testing.T) {
+	for _, mode := range []int64{0o700, 0o755, 0o777} {
+		header := &tar.Header{Typeflag: tar.TypeSymlink, Mode: mode}
+		normalizeHeader(header, "bin/link", nil, false)
+		if header.Mode != 0o777 {
+			t.Errorf("symlink mode %#o normalized to %#o, want 0777", mode, header.Mode)
+		}
+	}
+}
+
+func TestNormalizePreservesRegularFileMode(t *testing.T) {
+	for _, mode := range []int64{0o644, 0o755} {
+		header := &tar.Header{Typeflag: tar.TypeReg, Mode: mode}
+		normalizeHeader(header, "bin/file", nil, false)
+		if header.Mode != mode {
+			t.Errorf("file mode %#o changed to %#o", mode, header.Mode)
+		}
+	}
+}
